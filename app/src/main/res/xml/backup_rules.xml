<?xml version="1.0" encoding="utf-8"?><!--
   Notifyr keeps notification history, settings, and the encrypted PIN store private.
   Auto Backup is disabled in the manifest; these exclusions are kept as defense in depth
   for anyone who re-enables it, and to document exactly what must never leave the device.

   Users can still export their own data explicitly from Settings > Data Management.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
